# Backend configuration example. Copy to backend/.env and fill in locally.
# Never commit real values. The Flutter app does NOT read this file.
# The backend does not exist yet (stage 4); names below are the planned ones.

# Which GenerationProvider the backend uses: mock | hf_space | fal
GENERATION_PROVIDER=mock

# Hugging Face access token (free account) for the experimental hf_space provider.
# Create at https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=

# fal.ai API key. Paid — leave empty until the budget is approved.
FAL_KEY=

# Hard daily spend cap for paid providers, in USD.
DAILY_SPEND_LIMIT_USD=0

# How long generated results stay on the server, in hours.
RESULT_RETENTION_HOURS=24

# --- Flutter app (not read from this file; pass at build/run time) ---
# flutter run --dart-define=GENERATION_MODE=mock
# flutter run --dart-define=GENERATION_MODE=backend --dart-define=API_BASE_URL=http://localhost:8000
